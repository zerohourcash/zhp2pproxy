{
  "admin_token": "",
  "auto_update_enabled": true,
  "update_manifest_url": "https://github.com/zerohourcash/zhp2pproxy/releases/latest/download/update.json",
  "update_check_interval_seconds": 300,
  "multichain_catalog_disabled": false,
  "multichain_catalog_url": "https://zeroscan.st/.well-known/zhp2pproxy/chains.json",
  "multichain_catalog_cache_path": "chains.catalog.json",
  "multichain_catalog_refresh_seconds": 900,
  "allowed_ips": [],
  "trusted_proxies": [],
  "api_token": "",
  "bootstrap_peers": [],
  "bootstrap_urls": [
    "https://link.zeroscan.st/.well-known/zhp2pproxy/peers.json",
    "https://link.zeroscan.st/peers.json"
  ],
  "browser_webtransport_enabled": true,
  "browser_webtransport_port": 10003,
  "browser_webrtc_enabled": true,
  "browser_webrtc_port": 10004,
  "cors_allowed_origins": [
    "https://wallet.zeroscan.st",
    "https://sforwallet.io",
    "https://surpay.su",
    "http://localhost:5173",
    "http://127.0.0.1:5173"
  ],
  "enable_hole_punching": false,
  "enable_ipv6": true,
  "enable_nat_port_map": false,
  "enable_quic": true,
  "expose_peer_info": false,
  "force_relay": false,
  "identity_key_path": "identity.key",
  "listen": "127.0.0.1:8081",
  "local_rpc_prefer_direct": false,
  "multichain_rpc": [
    { "id": "ethereum-mainnet", "kind": "evm", "rpc_urls": ["https://ethereum-rpc.publicnode.com", "https://eth.llamarpc.com"], "enabled": true },
    { "id": "ethereum-sepolia", "kind": "evm", "rpc_urls": ["https://ethereum-sepolia-rpc.publicnode.com", "https://rpc.sepolia.org"], "enabled": true },
    { "id": "polygon-mainnet", "kind": "evm", "rpc_urls": ["https://polygon-bor-rpc.publicnode.com", "https://polygon.drpc.org"], "enabled": true },
    { "id": "bsc-mainnet", "kind": "evm", "rpc_urls": ["https://bsc-rpc.publicnode.com", "https://bsc-dataseed.bnbchain.org"], "enabled": true },
    { "id": "bsc-testnet", "kind": "evm", "rpc_urls": ["https://bsc-testnet-rpc.publicnode.com", "https://bsc-testnet-dataseed.bnbchain.org"], "enabled": true },
    { "id": "opbnb-mainnet", "kind": "evm", "rpc_urls": ["https://opbnb-rpc.publicnode.com", "https://opbnb-mainnet-rpc.bnbchain.org"], "enabled": true },
    { "id": "opbnb-testnet", "kind": "evm", "rpc_urls": ["https://opbnb-testnet-rpc.publicnode.com", "https://opbnb-testnet-rpc.bnbchain.org"], "enabled": true },
    { "id": "solana-mainnet", "kind": "solana", "rpc_urls": ["https://solana-rpc.publicnode.com", "https://api.mainnet-beta.solana.com"], "enabled": true },
    { "id": "solana-devnet", "kind": "solana", "rpc_urls": ["https://api.devnet.solana.com"], "enabled": true }
  ],
  "max_body_bytes": 1048576,
  "p2p_rpc_rate_limit": 5,
  "p2p_rpc_burst": 10,
  "p2p_rpc_max_concurrent": 8,
  "p2p_rpc_quorum": 2,
  "p2p_rpc_response_bytes": 16777216,
  "p2p_max_tunnels": 64,
  "p2p_max_tunnels_per_peer": 4,
  "p2p_max_bytes_per_second": 8388608,
  "p2p_handshake_timeout_seconds": 10,
  "node_p2p_magic": "f1cfa6d3",
  "native_p2p_proxy": true,
  "node_config_path": "",
  "node_p2p_host": "127.0.0.1",
  "node_p2p_port": 38100,
  "overlay_mode": "public-relay",
  "overlay_network_id": "zhcash-proxy-main",
  "overlay_private": true,
  "overlay_psk": "",
  "p2p_load_balance": true,
  "p2p_port": 10001,
  "p2p_proxy_listen": "127.0.0.1:3890",
  "peer_store_path": "peers.json",
  "public_endpoint": "",
  "rate_burst": 40,
  "rate_limit": 20,
  "relay_enabled": true,
  "rpc_cookie_path": "",
  "rpc_host": "127.0.0.1",
  "rpc_pass": "",
  "rpc_port": 3889,
  "rpc_url": "",
  "rpc_user": ""
}
